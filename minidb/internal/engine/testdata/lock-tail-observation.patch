diff --git a/minidb/internal/engine/locks_tail_test.go b/minidb/internal/engine/locks_tail_test.go
new file mode 100644
index 0000000..d289ab8
--- /dev/null
+++ b/minidb/internal/engine/locks_tail_test.go
@@ -0,0 +1,132 @@
+package engine_test
+
+import (
+	"cmp"
+	"context"
+	"math"
+	"os"
+	"runtime/metrics"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/celanwang/miniinfra/minidb/internal/server"
+)
+
+type lockTailCosts struct {
+	statements                                               int
+	dispatch, exec, reply, acquire, manager, row, key, table time.Duration
+}
+
+type lockTailTrace struct {
+	mu     sync.Mutex
+	active map[string]int
+	costs  map[int]lockTailCosts
+	before *metrics.Float64Histogram
+}
+
+func lockTailObserver(t *testing.T) (context.Context, *lockTailTrace) {
+	t.Helper()
+	if os.Getenv("MINIDB_LOCK_TRACE") == "" {
+		return t.Context(), nil
+	}
+	observer := &lockTailTrace{active: make(map[string]int), costs: make(map[int]lockTailCosts)}
+	return server.ObserveStatements(t.Context(), observer.observe), observer
+}
+
+func (trace *lockTailTrace) start() {
+	trace.before = schedulerLatency()
+}
+
+func (trace *lockTailTrace) observe(sample server.StatementTiming) {
+	trace.mu.Lock()
+	defer trace.mu.Unlock()
+	switch sample.Request.SQL {
+	case "insert into lock_orders values (?,?)":
+		trace.active[sample.Peer] = int(sample.Request.Args[0].Int)
+	case lockLoadUpdate, "insert into lock_items values (?,?),(?,?)":
+	default:
+		return
+	}
+	id := trace.active[sample.Peer]
+	cost := trace.costs[id]
+	cost.statements++
+	cost.dispatch += sample.Started.Sub(sample.Decoded)
+	cost.exec += sample.Executed.Sub(sample.Started)
+	cost.reply += sample.Replying.Sub(sample.Executed)
+	cost.acquire += sample.Locks.Acquire
+	cost.manager += sample.Locks.ManagerWait
+	cost.row += sample.Locks.RowWait
+	cost.key += sample.Locks.UniqueWait
+	cost.table += sample.Locks.TableWait
+	trace.costs[id] = cost
+}
+
+func (trace *lockTailTrace) report(t *testing.T, samples []lockLoadSample) {
+	t.Helper()
+	trace.mu.Lock()
+	defer trace.mu.Unlock()
+	for _, sample := range samples {
+		if cost := trace.costs[sample.order]; cost.statements != 4 || cost.row != 0 || cost.key != 0 ||
+			cost.dispatch+cost.exec+cost.reply > sample.sql {
+			t.Fatalf("order %d unexpected trace: %+v", sample.order, cost)
+		}
+	}
+	slices.SortFunc(samples, func(a, b lockLoadSample) int { return cmp.Compare(a.sql, b.sql) })
+	threshold := (len(samples)*99+99)/100 - 1
+	sample := samples[threshold]
+	cost := trace.costs[sample.order]
+	t.Logf("p99_order sql=%s residual=%s dispatch=%s exec=%s reply=%s lock=%s manager=%s table=%s",
+		sample.sql, sample.sql-cost.dispatch-cost.exec-cost.reply, cost.dispatch, cost.exec, cost.reply, cost.acquire, cost.manager, cost.table)
+	var total, outside, dispatch, exec, reply, acquire, manager, table, acquireMax time.Duration
+	tail := samples[threshold+1:]
+	if len(tail) == 0 {
+		tail = samples[threshold:]
+	}
+	for _, sample := range tail {
+		cost := trace.costs[sample.order]
+		total += sample.sql
+		outside += sample.sql - cost.dispatch - cost.exec - cost.reply
+		dispatch += cost.dispatch
+		exec += cost.exec
+		reply += cost.reply
+		acquire += cost.acquire
+		manager += cost.manager
+		table += cost.table
+		acquireMax = max(acquireMax, cost.acquire)
+	}
+	n := time.Duration(len(tail))
+	t.Logf("tail count=%d sql_mean=%s residual_mean=%s dispatch_mean=%s exec_mean=%s reply_mean=%s lock_mean=%s lock_max=%s manager_mean=%s table_mean=%s",
+		n, total/n, outside/n, dispatch/n, exec/n, reply/n, acquire/n, acquireMax, manager/n, table/n)
+	t.Logf("runtime runnable_p99_ceiling=%s", schedulerP99Ceiling(trace.before, schedulerLatency()))
+}
+
+func schedulerLatency() *metrics.Float64Histogram {
+	sample := []metrics.Sample{{Name: "/sched/latencies:seconds"}}
+	metrics.Read(sample)
+	latency := sample[0].Value.Float64Histogram()
+	return &metrics.Float64Histogram{Counts: slices.Clone(latency.Counts), Buckets: latency.Buckets}
+}
+
+func schedulerP99Ceiling(before, after *metrics.Float64Histogram) time.Duration {
+	var total uint64
+	for i, count := range after.Counts {
+		total += count - before.Counts[i]
+	}
+	target := (total*99 + 99) / 100
+	if target == 0 {
+		return 0
+	}
+	for i, count := range after.Counts {
+		added := count - before.Counts[i]
+		if added >= target {
+			if math.IsInf(after.Buckets[i+1], 1) {
+				return 0
+			}
+			return time.Duration(after.Buckets[i+1] * float64(time.Second))
+		}
+		target -= added
+	}
+	return 0
+}
diff --git a/minidb/internal/server/observation.go b/minidb/internal/server/observation.go
new file mode 100644
index 0000000..c6c0455
--- /dev/null
+++ b/minidb/internal/server/observation.go
@@ -0,0 +1,29 @@
+package server
+
+import (
+	"context"
+	"time"
+
+	"github.com/celanwang/miniinfra/minidb/internal/engine"
+	"github.com/celanwang/miniinfra/minidb/internal/wire"
+)
+
+type StatementTiming struct {
+	Peer                                 string
+	Request                              wire.Request
+	Decoded, Started, Executed, Replying time.Time
+	Locks                                engine.LockTiming
+}
+
+type statementObserverKey struct{}
+
+// ObserveStatements opts a server into request timing. The server publishes
+// observations after attempting each reply. Calls can overlap across sessions.
+func ObserveStatements(ctx context.Context, observe func(StatementTiming)) context.Context {
+	return context.WithValue(ctx, statementObserverKey{}, observe)
+}
+
+type decodedRequest struct {
+	wire.Request
+	decoded time.Time
+}
