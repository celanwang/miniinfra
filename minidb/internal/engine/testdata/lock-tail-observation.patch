@@ -307,0 +316,16 @@ type transactionTiming struct {
+type LockTiming struct {
+	Acquire, ManagerWait, RowWait, UniqueWait, TableWait time.Duration
+}
+
+// MeasureLocks records timings for the next operation on this session's
+// transaction. Call finish before the session starts another operation.
+func (tx *Txn) MeasureLocks() (finish func() LockTiming) {
+	previous := tx.timing
+	timing := &transactionTiming{}
+	tx.timing = timing
+	return func() LockTiming {
+		tx.timing = previous
+		return LockTiming{timing.acquire, timing.lockManagerWait, timing.rowWait, timing.uniqueWait, timing.tableWait}
+	}
+}
+
diff --git a/minidb/internal/query/execute.go b/minidb/internal/query/execute.go
index 34f1c07..49771e6 100644
--- a/minidb/internal/query/execute.go
+++ b/minidb/internal/query/execute.go
@@ -49,0 +50,12 @@ func (s *Session) abort() {
+// ExecuteWithLockTiming measures locks on a statement inside an explicit
+// transaction. The execution and transaction boundaries are unchanged.
+func (s *Session) ExecuteWithLockTiming(ctx context.Context, sql string, args []engine.Value) (Result, engine.LockTiming, error) {
+	if s.tx == nil {
+		result, err := s.Execute(ctx, sql, args)
+		return result, engine.LockTiming{}, err
+	}
+	finish := s.tx.MeasureLocks()
+	result, err := s.Execute(ctx, sql, args)
+	return result, finish(), err
+}
+
